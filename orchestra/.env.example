# Chiavi Orchestra — NON committare questo file (.gitignore lo esclude)
# Copia: orchestra/.env  ->  orchestra/.env.example e riempi

# Provider: openrouter | groq | nvidia | together | cerebras | mistral | openai | nous
ORCHESTRA_PROVIDER=openrouter

# Modello. Per OpenRouter, suffisso :free = zero costi.
# Vedi `python -m orchestra.cli models` per l'elenco aggiornato.
ORCHESTRA_MODEL=stealth/space-bunny-alpha

# Limiti
ORCHESTRA_MAX_ITERATIONS=12
ORCHESTRA_CONTEXT_LIMIT=120000
ORCHESTRA_KEEP_RECENT=8
ORCHESTRA_TEMPERATURE=0.7
ORCHESTRA_MAX_TOKENS=4096

# --- chiavi provider ---
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=
NOUS_API_KEY=
